#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"

CELL_TYPE="K562"
BASE_DIR="${BASE_DIR:-${REPO_ROOT}/data/chrombpnet}"
THREADS="${THREADS:-4}"

BAM_ACCESSIONS=(
  ENCFF077FBI
  ENCFF128WZG
  ENCFF534DCE
)

# ChromBPNet wiki K562 relaxed/default overlap peaks for ENCSR868FGK.
PEAKS_EXPERIMENT="${PEAKS_EXPERIMENT:-ENCSR868FGK}"
PEAKS_ACCESSION="${PEAKS_ACCESSION:-ENCFF333TAT}"

# Use ENCODE/downloaded peaks by default. Set CALL_PEAKS=1 to run MACS2.
CALL_PEAKS="${CALL_PEAKS:-0}"
