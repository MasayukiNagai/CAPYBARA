#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"

CELL_TYPE="H1-hESC"
BASE_DIR="${BASE_DIR:-${REPO_ROOT}/data/chrombpnet}"
THREADS="${THREADS:-4}"

# H1-hESC ATAC data used by ChromBPNet is from GEO GSE267154, not the same
# ENCODE filtered-BAM workflow as the other cell types. Fill these paths after
# manually preparing or placing the replicate BAMs under the raw sample dir.
BAM_REPLICATES=()

CALL_PEAKS="${CALL_PEAKS:-0}"
